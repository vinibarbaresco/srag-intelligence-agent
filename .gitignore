# --- Segredos ----------------------------------------------------------------
.env
*.key

# --- Configuracao local do assistente (por maquina, nao do projeto) ----------
.claude/settings.local.json

# --- Dados (nunca versionar: sao reproduziveis via src/data/download.py) -----
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/analytics/*
!data/analytics/.gitkeep

# --- Artefatos de execucao ---------------------------------------------------
outputs/*
!outputs/.gitkeep

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Sistema operacional -----------------------------------------------------
Thumbs.db
.DS_Store
