# =============================================================================
# Indicium HealthCare - SRAG Intelligence Agent
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA versione o arquivo `.env`.
# =============================================================================

# --- LLM (obrigatorio, exceto quando executado com `python main.py --no-llm`) -
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Janela epidemiologica ---------------------------------------------------
# Dias descartados no fim da serie para nao confundir atraso de notificacao
# com queda real de casos. O padrao (21) foi calibrado no percentil 75-90 do
# atraso observado na propria base; use `--diagnostics` para reavalia-lo.
REPORTING_LAG_DAYS=21
# Tamanho (em dias) das janelas comparadas na taxa de aumento de casos.
GROWTH_WINDOW_DAYS=30

# --- Privacidade -------------------------------------------------------------
# Agregados com contagem menor que este valor sao suprimidos antes de chegar
# ao LLM ou ao relatorio (protecao contra reidentificacao).
MIN_CELL_SIZE=5

# --- Ingestao ----------------------------------------------------------------
# Anos do dataset SRAG a processar (separados por virgula).
SRAG_YEARS=2025,2026

# --- Noticias ----------------------------------------------------------------
NEWS_MAX_AGE_DAYS=45
NEWS_MAX_RESULTS=12

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=INFO

# --- Raiz de dados (opcional) ------------------------------------------------
# Redireciona data/ e outputs/ para outro diretorio. Deixe vazio para usar a
# raiz do projeto.
# DATA_ROOT=
