# A chave e opcional. Sem ela, o projeto usa interpretacao e embeddings locais.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Janelas epidemiologicas
REPORTING_LAG_DAYS=21
GROWTH_WINDOW_DAYS=30
SRAG_YEARS=2025,2026

# Noticias
NEWS_MAX_AGE_DAYS=45
NEWS_MAX_RESULTS=12
NEWS_REFRESH_ON_RUN=true

# Observabilidade
LOG_LEVEL=INFO

# Opcional: redireciona data/ e outputs/ para outra raiz.
# DATA_ROOT=C:/dados/srag
