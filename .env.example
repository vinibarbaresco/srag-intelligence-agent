# A chave e opcional. Sem ela, o projeto usa interpretacao e embeddings locais
# e a revisao semantica da saida fica desativada (declarado no relatorio).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.0

# Revisor semantico independente da saida (segunda camada de guardrail).
# Modelo mais forte que o redator: le ~2 mil tokens por execucao.
SEMANTIC_JUDGE_ENABLED=true
OPENAI_JUDGE_MODEL=gpt-4o

# Precos de lista (USD por 1M tokens) usados so para ESTIMAR o custo por execucao.
OPENAI_INPUT_PRICE_PER_1M_TOKENS=0.15
OPENAI_OUTPUT_PRICE_PER_1M_TOKENS=0.60
OPENAI_JUDGE_INPUT_PRICE_PER_1M_TOKENS=2.50
OPENAI_JUDGE_OUTPUT_PRICE_PER_1M_TOKENS=10.00

# Janelas epidemiologicas
REPORTING_LAG_DAYS=21
GROWTH_WINDOW_DAYS=30
SRAG_YEARS=2022,2023,2024,2025,2026

# Baseline sazonal: anos comparados com a mesma janela de calendario.
# 2020 e 2021 (pandemia) nunca entram; 2019 (regime pre-pandemico) fica fora do padrao.
BASELINE_YEARS=2022,2023,2024
BASELINE_MIN_YEARS=2

# Censo de UTI: teto de permanencia para estadias sem saida registrada.
ICU_STAY_CAP_PERCENTILE=0.95
# ICU_STAY_CAP_DAYS=28

# Privacidade: piso de denominador para publicar uma proporcao.
MIN_CELL_SIZE=5

# Alertas (limiares, em %). Com --fail-on-alert, regra disparada = codigo de saida 2.
ALERT_GROWTH_THRESHOLD_PCT=20
ALERT_MORTALITY_THRESHOLD_PCT=10
ALERT_BASELINE_EXCESS_THRESHOLD_PCT=50

# Referencias externas (padrao: data/reference/*.csv, versionadas com o codigo).
# POPULATION_REFERENCE_PATH=data/reference/populacao_uf.csv
# VACCINATION_REFERENCE_PATH=data/reference/cobertura_vacinal_uf.csv

# Noticias
NEWS_MAX_AGE_DAYS=45
NEWS_MAX_RESULTS=12
NEWS_REFRESH_ON_RUN=true

# API HTTP (python -m src.api)
API_HOST=127.0.0.1
API_PORT=8000

# Observabilidade
LOG_LEVEL=INFO
# Tracing opcional via LangSmith (lido automaticamente pelo langchain):
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=srag-intelligence-agent

# Opcional: redireciona data/ e outputs/ para outra raiz.
# DATA_ROOT=C:/dados/srag
